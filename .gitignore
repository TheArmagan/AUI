# Editor tooling build output (tools~ is invisible to Unity, not to git)
tools~/aui-lsp/bin/
tools~/aui-lsp/obj/
tools~/aui-lsp/TestResults/
tools~/vscode-aui/node_modules/
tools~/vscode-aui/out/
tools~/vscode-aui/server/
tools~/vscode-aui/*.vsix

# Documentation site (tools~/docs)
tools~/docs/node_modules/
tools~/docs/.vitepress/cache/
tools~/docs/.vitepress/dist/
tools~/docs/.wrangler/

# The golden test's diff-me file (written on a mismatch, deleted on the next pass)
Tests/Editor/Golden/*.actual.txt
Tests/Editor/Golden/*.actual.txt.meta

# OS / IDE
.DS_Store
Thumbs.db
.vs/
.idea/
*.user
