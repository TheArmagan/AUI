/* AUI default theme. Every value here can be overridden by a linked sheet or an inline
   <style>; variables can be redefined in any :root block. Units are millimetres. */

:root {
  --base:    #150F0B;
  --nav:     #17120D;
  --surface: #1E1610;
  --panel:   #291E17;
  --card:    #241B14;
  --border:  #2B231C;
  --chip:    #3E3126;
  --accent:  #E0A86A;
  --text:    #EEE1D2;
  --muted:   #A38C76;
}

view {
  background: sprite(Rounded12) var(--base);
  padding: 16;
  gap: 12;
  flex-direction: column;
  color: var(--text);
  icon-color: var(--text);
  font: 400 18;
  show: fade-scale;
}

panel { flex-direction: column; gap: 8; }
spacer { grow: 1; }
icon { width: 18; height: 18; }
text { }

.title { font: 600 26; }
.muted { color: var(--muted); }
.row { flex-direction: row; align: center; gap: 12; }
.grid { flex-direction: row; wrap: true; gap: 8; }
.card { background: sprite(Rounded8) var(--card); padding: 12; gap: 8; }
.chip { padding: 6 12; min-height: 32; font: 500 16; }

button {
  background: sprite(Rounded8) var(--chip);
  padding: 8 14;
  min-height: 36;
  flex-direction: row;
  align: center;
  justify: center;
  gap: 8;
  font: 500 18;
  transition: background 0.12s out-quad, color 0.12s out-quad, icon-color 0.12s out-quad, scale 0.1s out-back;
}
button:hover    { background: var(--accent); color: var(--base); icon-color: var(--base); scale: 1.03; }
button:pressed  { scale: 0.96; }
button:selected { background: var(--accent); color: var(--base); icon-color: var(--base); }
button:disabled { opacity: 0.4; }
/* Invisible at rest but keeps the rounded sprite, so the hover chip has the same corners as every other button. */
.ghost { background: sprite(Rounded8) transparent; }
.ghost:hover { background: var(--chip); color: var(--text); icon-color: var(--text); }

/* A toggle is a 36 mm square when it only carries an icon (the icon is the "on" mark and is
   hidden while off); with a key it grows into a labelled switch. */
toggle {
  background: sprite(Rounded8) var(--chip);
  padding: 9;
  min-height: 36;
  min-width: 36;
  flex-direction: row;
  align: center;
  justify: center;
  gap: 8;
  font: 500 18;
  icon-color: transparent;
  transition: background 0.12s out-quad, color 0.12s out-quad, icon-color 0.12s out-quad, scale 0.1s out-back;
}
toggle:hover    { scale: 1.03; }
toggle:pressed  { scale: 0.96; }
toggle:selected { background: var(--accent); color: var(--base); icon-color: var(--base); }
toggle:disabled { opacity: 0.4; }

tabs { flex-direction: row; gap: 4; }
tab {
  background: none;
  padding: 8 14;
  min-height: 36;
  flex-direction: row;
  align: center;
  justify: center;
  gap: 8;
  font: 500 18;
  color: var(--muted);
  icon-color: var(--muted);
  transition: color 0.12s out-quad, icon-color 0.12s out-quad, background 0.12s out-quad;
}
tab:hover    { color: var(--text); icon-color: var(--text); }
tab:selected { color: var(--accent); icon-color: var(--accent); background: sprite(Rounded8) var(--surface); }

pages { grow: 1; }
page  { anchor: fill; flex-direction: column; gap: 8; page-transition: fade; }

slider { width: 160; height: 24; background: var(--chip); color: var(--accent); }
slider:disabled { opacity: 0.4; }

input {
  background: sprite(Rounded8) var(--surface);
  border: var(--border);
  padding: 8 12;
  min-height: 36;
  min-width: 160;
  align: center;
  transition: border 0.12s out-quad;
}
input:hover    { border: var(--accent); }
input:disabled { opacity: 0.4; }

select {
  background: sprite(Rounded8) var(--surface);
  border: var(--border);
  padding: 8 12;
  min-height: 36;
  min-width: 160;
  flex-direction: row;
  align: center;
  gap: 8;
  transition: border 0.12s out-quad;
}
select:hover    { border: var(--accent); }
select:disabled { opacity: 0.4; }
/* Options sit 4 mm inside the Rounded8 popup, so a 4 mm radius keeps the hover chip concentric with it. */
option {
  padding: 8 12;
  min-height: 32;
  background: sprite(Rounded4) transparent;
  transition: background 0.1s out-quad;
}
option:hover    { background: var(--chip); }
option:selected { color: var(--accent); }

repeat { flex-direction: column; gap: 8; }
empty  { color: var(--muted); }
