/* Styles for SettingsDemo.aui.
   A sheet named like the view (SettingsDemo.auis next to SettingsDemo.aui) is linked
   automatically. To use another file, or several, write <link href="Shared.auis"/> under the
   <view> instead; the explicit links then replace the sibling. Later sheets win over earlier
   ones, and all of them win over the package theme. */

:root {
  --accent: #F0B072;      /* a touch warmer than the theme's #E0A86A */
  --row: #1A130E;
}

/* One settings row: label on the left, control on the right, a faint band behind. */
.setting {
  flex-direction: row;
  align: center;
  gap: 12;
  padding: 6 10;
  background: sprite(Rounded8) var(--row);
  transition: background 0.12s out-quad;
}
.setting:hover { background: var(--card); }

/* The footer sits on its own line with a little air above it. */
.footer {
  flex-direction: row;
  align: center;
  gap: 12;
  margin: 8 0 0 0;
}

/* The primary action: filled with the accent, dark text. */
.primary { background: sprite(Rounded8) var(--accent); color: var(--base); icon-color: var(--base); }
.primary:hover { background: var(--text); scale: 1.03; }
.primary:pressed { scale: 0.96; }
