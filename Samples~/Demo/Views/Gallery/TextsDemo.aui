<view name="TextsDemo" width="488" height="300" show="none">
  <text key="texts.keyed" class="title"/>
  <panel class="row"><text key="texts.boundLabel" class="muted"/><text id="bound" text="{status}"/></panel>
  <panel class="row"><text key="texts.argsLabel" class="muted"/><text id="args" key="texts.args" args="{who} {count}"/></panel>
  <text id="wrapped" key="texts.wrap" wrap="true" style="max-width: 456; font-size: 15" class="muted"/>
  <panel class="grid">
    <button onclick="SetHello" key="texts.setHello"/>
    <button onclick="SetLong" key="texts.setLong"/>
    <button onclick="Inject" key="texts.inject" class="ghost"/>
    <button onclick="Bump" key="texts.bump" class="ghost"/>
  </panel>
</view>
