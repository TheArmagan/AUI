<view name="RuntimeDemo" width="566" height="514" pool="text:6" icons="check x info triangle-alert">
  <!-- Nothing is instantiated in-world: a template of chat lines, a pool of plain texts, a
       template holding a nested view (PlayerCard) with a typed event, and a modal over a backdrop. -->
  <link href="Showcase.auis"/>
  <event name="changed"/>

  <panel class="row">
    <text key="runtime.title" class="section"/>
    <spacer/>
    <text text="{status}" class="hint" style="max-width: 300"/>
  </panel>
  <panel class="row">
    <button onclick="Say" key="runtime.say" icon="pencil" class="chip"/>
    <button onclick="Note" key="runtime.note" icon="info" class="chip ghost"/>
    <button onclick="Lift" icon="chevron-up" class="chip ghost"/>
    <button onclick="Drop" icon="x" class="chip ghost"/>
    <spacer/>
    <button onclick="AskClear" key="runtime.clear" icon="trash-2" class="chip danger"/>
  </panel>

  <panel class="row" style="align: start">
    <panel id="log" class="card *grow" style="gap: 4; min-height: 200"/>
    <panel style="gap: 8; min-width: 210">
      <panel class="row">
        <text key="runtime.cards" class="hint"/>
        <spacer/>
        <button onclick="Deal" key="runtime.deal" icon="plus" class="chip"/>
      </panel>
      <panel id="deck" style="gap: 6"/>
    </panel>
  </panel>

  <!-- Parked copies, linked under any container by CreateLine(parent). -->
  <template id="line" max="8">
    <panel class="row" style="gap: 8">
      <icon name="check" class="ok" size="16"/>
      <text text="{item.who}" class="accent *font-semibold" style="min-width: 56"/>
      <text text="{item.msg}" style="max-width: 220"/>
    </panel>
  </template>

  <!-- A nested view inside a template: its on-kicked handler receives the instance element first. -->
  <template id="cards" max="3">
    <PlayerCard on-kicked="CardKicked"/>
  </template>

  <modal id="confirm" enabled="{asking}" onclose="Cancelled" show="fade-scale">
    <panel class="row">
      <icon name="triangle-alert" class="warn" size="22"/>
      <text key="runtime.sure" class="section"/>
    </panel>
    <text key="runtime.sureHint" class="hint" wrap="true" style="max-width: 260"/>
    <panel class="row">
      <spacer/>
      <button onclick="CloseConfirm" key="runtime.no" class="ghost"/>
      <button onclick="ConfirmClear" key="runtime.yes" class="danger"/>
    </panel>
  </modal>
</view>
